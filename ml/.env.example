# CampusIQ ML service (FastAPI) — environment template for cloud deployment.
# The service runs with zero required variables; everything below is
# optional and only needed if you override the Docker defaults.
# Do NOT commit real secrets.

# HTTP port uvicorn listens on (optional, Dockerfile default is 8000).
PORT="8000"

# Path to the trained model artifact, relative to the workdir /app
# (optional, defaults to models/student_performance_model.joblib).
MODEL_PATH="models/student_performance_model.joblib"
