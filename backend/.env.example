# CampusIQ Backend — environment template for cloud deployment.
# Copy to `.env` for local dev, or inject these variables in your
# cloud provider dashboard. Do NOT commit real secrets.

# PostgreSQL connection string (required by Prisma + the app).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Secret used to sign/verify JWTs (required). Use a long random value.
JWT_SECRET="change-me-to-a-long-random-secret"

# Python ML microservice endpoint (optional — defaults to local FastAPI).
# Accepts the base URL or the full predict URL.
ML_API_URL="http://127.0.0.1:8000"

# HTTP port the Express server listens on (optional, defaults to 5000).
# Most cloud providers inject PORT automatically.
PORT="5000"

# SMTP Configuration for monthly attendance emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="CampusIQ <noreply@campusiq.example.com>"
