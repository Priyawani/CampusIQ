generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  DEPT_ADMIN
  FACULTY
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum ExamType {
  INTERNAL
  MIDTERM
  END_SEMESTER
  ASSIGNMENT
  QUIZ
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role     @default(FACULTY)
  name         String?
  phone        String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Tenancy: which department does this admin/faculty belong to?
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Faculty class assignments
  assignedClasses ClassGroup[] @relation("FacultyClasses")

  studentProfile Student?
  faculty        Faculty?

  @@index([departmentId])
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  specializations Specialization[]
  classGroups     ClassGroup[]
  faculty         Faculty[]
  subjects        Subject[]
  users           User[]
  students        Student[]
}

model Specialization {
  id           Int          @id @default(autoincrement())
  name         String
  departmentId Int
  department   Department   @relation(fields: [departmentId], references: [id])
  classGroups  ClassGroup[]
  createdAt    DateTime     @default(now())

  @@unique([name, departmentId])
}

model ClassGroup {
  id               Int             @id @default(autoincrement())
  name             String
  year             Int
  departmentId     Int
  department       Department      @relation(fields: [departmentId], references: [id])
  specializationId Int?
  specialization   Specialization? @relation(fields: [specializationId], references: [id])
  students         Student[]
  faculties        User[]          @relation("FacultyClasses")
  createdAt        DateTime        @default(now())

  @@unique([name, departmentId])
}

model Student {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  rollNumber    String    @unique
  firstName     String
  lastName      String
  phone         String?
  dateOfBirth   DateTime?
  admissionYear Int
  classGroupId  Int?
  departmentId  Int?
  rollNo        String?
  contactNo     String?
  parentEmail   String?
  parentMobile  String?

  user       User        @relation(fields: [userId], references: [id])
  classGroup ClassGroup? @relation(fields: [classGroupId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  enrollments Enrollment[]

  @@index([departmentId])
}

model Faculty {
  id           Int    @id @default(autoincrement())
  userId       Int    @unique
  employeeId   String @unique
  firstName    String
  lastName     String
  departmentId Int

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
}

model Subject {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  credits      Int
  departmentId Int
  abbreviation String?
  createdAt    DateTime @default(now())

  department  Department   @relation(fields: [departmentId], references: [id])
  enrollments Enrollment[]
}

model Enrollment {
  id           Int      @id @default(autoincrement())
  studentId    Int
  subjectId    Int
  semester     Int
  academicYear String
  createdAt    DateTime @default(now())

  student    Student      @relation(fields: [studentId], references: [id])
  subject    Subject      @relation(fields: [subjectId], references: [id])
  attendance Attendance[]
  marks      Mark[]

  @@unique([studentId, subjectId, semester, academicYear])
}

model Attendance {
  id           Int              @id @default(autoincrement())
  enrollmentId Int
  date         DateTime
  status       AttendanceStatus

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([enrollmentId, date])
}

model Mark {
  id            Int      @id @default(autoincrement())
  enrollmentId  Int
  examType      ExamType
  marksObtained Float
  maxMarks      Float

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
}
